# Backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Mercado Pago (public key only — safe to expose client-side)
NEXT_PUBLIC_MP_PUBLIC_KEY=your-mp-public-key

# Cloudinary (cloud name only — safe to expose client-side; used to build display URLs)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
