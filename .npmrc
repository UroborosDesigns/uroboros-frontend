# Turbopack (Next.js 16's default bundler) fails to resolve the local
# file:../uroboros-types dependency when npm installs it as a symlink (a
# reproducible Turbopack limitation with symlinked packages, affecting both
# `next dev` and `next build`). install-links=true makes npm copy file:
# dependencies into node_modules instead of symlinking them, which sidesteps
# the bug entirely and — as a side benefit — matches how uroboros-types will
# actually be installed in production (as a git-tag dependency, never a
# symlink). The tradeoff: after editing uroboros-types locally, you need to
# re-run `npm install` here to pick up the change (rather than it updating
# live through a symlink).
install-links=true
